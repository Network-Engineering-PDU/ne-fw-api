[Unit]
Description=Remote Google Drive Firmware Updater for PDU
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pdu_remote_update/config.json

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m ttne.app.settings.remote_drive_updater --config /etc/pdu_remote_update/config.json
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
