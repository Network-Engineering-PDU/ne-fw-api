[Unit]
Description=Confirm successful boot after OTA update
After=ttnedaemon.service network.target
Requires=ttne-ota-health-boot.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/python3 -m ttne.ota.boot_health mark-success && /usr/bin/fw_setenv ota_boot_ok 1 && /usr/bin/fw_setenv ota_boot_tries 0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
